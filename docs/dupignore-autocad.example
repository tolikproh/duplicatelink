# Пример .dupignore для AutoCAD
# Игнорирует все основные документы и связанные файлы AutoCAD
# Формат аналогичен .gitignore

# --- Чертежи и обмен ---
*.dwg     # основной формат чертежа AutoCAD
*.dxf     # обменный формат чертежа
*.dxb     # бинарный формат блоков/экспорта

# --- Шаблоны, стандарты, листы ---
*.dwt     # шаблон чертежа
*.dws     # файл стандартов чертежа
*.dst     # набор листов (Sheet Set)
*.dxe     # шаблон извлечения данных

# --- Форматы публикации ---
*.dwf     # Design Web Format
*.dwfx    # Design Web Format (XPS)

# --- Автосохранение и бэкапы ---
*.bak     # резервная копия чертежа
*.sv$     # файл автосохранения (старые версии)
*.ac$     # файл автосохранения (новые версии)

# --- Печать и стили ---
*.pc3     # конфигурация плоттера/печати
*.pmp     # карта перьевых профилей плоттера
*.ctb     # стиль печати (по цвету)
*.stb     # стиль печати (по имени)

# --- Шрифты, штриховки, типы линий ---
*.shx     # шрифты/формы AutoCAD
*.pat     # штриховки
*.lin     # типы линий

# --- Палитры, профили, скрипты ---
*.xtp     # экспорт палитр инструментов
*.xpg     # группа палитр инструментов
*.arg     # профиль AutoCAD
*.scr     # скрипты AutoCAD

# --- Прочие вспомогательные ---
*.cfg     # конфигурации (если используются)

# Примечание: удалите строки, которые не актуальны для вашего проекта.
