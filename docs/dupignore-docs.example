# Пример .dupignore для различных документальных форматов
# Игнорирует распространённые типы файлов документов
# Формат аналогичен .gitignore

# --- Универсальные документы ---
*.pdf
*.rtf
*.txt
*.log

# --- Markdown и документация ---
*.md
*.markdown
*.rst
*.adoc

# --- LaTeX (при необходимости, раскомментируйте) ---
# *.tex
# *.bib
# *.cls
# *.sty

# --- Microsoft Office ---
*.doc
*.docx
*.dot
*.dotx
*.xls
*.xlsx
*.xlt
*.xltx
*.csv
*.tsv
*.ppt
*.pptx
*.pot
*.potx

# --- OpenDocument (LibreOffice / OpenOffice) ---
*.odt
*.ott
*.ods
*.ots
*.odp
*.otp
*.odg
*.fodt
*.fods
*.fodp
*.fodg

# --- Apple iWork ---
*.pages
*.numbers
*.key

# --- Электронные книги ---
*.epub
*.mobi
*.azw
*.azw3
*.djvu

# --- Microsoft Visio / OneNote ---
*.vsd
*.vsdx
*.one

# --- XML / JSON (если используются как документы) ---
# *.xml
# *.json

# --- Папки документации (при необходимости) ---
# Docs/
# Documentation/
# Документы/

# Примечания:
# 1) Удалите или закомментируйте строки, которые не актуальны для вашего проекта.
# 2) Шаблоны применяются к путям относительно корневой папки.
# 3) Для игнорирования конкретной папки используйте суффикс '/': например, 'reports/'.
